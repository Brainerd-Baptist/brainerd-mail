# Copy to .env.local. Never commit real values.

# Brainerd Mail's OWN Supabase project (never reuse another app's project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app, e.g. https://mail.brainerdhq.app (no trailing slash needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ClearStream (read lists, send texts). Server-side only.
CLEARSTREAM_API_KEY=

# Email sending through Resend. For testing, send from the verified brainerdhq.app domain to staff only.
RESEND_API_KEY=
MAIL_FROM="Brainerd Mail <mail@brainerdhq.app>"

# Secret for scheduled jobs (approval reminders, auto-send). Sent as Bearer token.
CRON_SECRET=

# Optional: tell the website to refresh its missions page the moment the map is saved.
# The address is a page on the website that accepts a POST with this secret. Leave blank until the website has it.
WEBSITE_REVALIDATE_URL=
WEBSITE_REVALIDATE_SECRET=

# Secret used to sign tracking links.
TRACKING_SECRET=

# Polish "Ask for ideas" (Claude writing suggestions). Server-side only. Optional model override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
